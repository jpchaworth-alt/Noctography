      {
        "selector": "JSXOpeningElement[name.name='ReferenceCard'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:night|nightvision)$/]",
        "message": "<ReferenceCard> theme must be one of 'night' | 'nightvision'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|align|rule|level|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, align, rule, level."
