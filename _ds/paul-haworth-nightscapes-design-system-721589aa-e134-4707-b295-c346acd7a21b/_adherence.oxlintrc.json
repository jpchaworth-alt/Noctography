      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|options|value|onChange|size|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: name, options, value, onChange, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|field)$/]",
        "message": "<Radio> size must be one of 'md' | 'field'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReferenceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:topic|title|number|theme|width|ratio|footer|children|key|ref|className|style|children)$/]",
        "message": "<ReferenceCard> doesn't accept that prop. Declared props: topic, title, number, theme, width, ratio, footer, children."
